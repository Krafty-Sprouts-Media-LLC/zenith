{
    "manifest": 1,
    "code": "zenith",
    "name": "Zenith",
    "version": "0.1.0",
    "description": "A simple list-shaped theme for Teme (foundation; full skin in later releases).",
    "author": "Krafty Sprouts Media LLC",
    "author_url": "https://kraftysprouts.com",
    "homepage": "https://github.com/Krafty-Sprouts-Media-LLC/zenith",
    "license": "MIT",
    "requires": {
        "teme": ">=1.3.2 <2.0"
    },
    "title_separator": "—",
    "per_page": 10,
    "layout": {
        "content": 720,
        "wide": 1280,
        "full": null
    },
    "images": {
        "content": "(min-width: 48rem) 720px, 100vw",
        "wide": "(min-width: 80rem) 1280px, 100vw",
        "feature": "(min-width: 64rem) 560px, 100vw",
        "lead": "(min-width: 64rem) 720px, 100vw",
        "card": "(min-width: 40rem) 33vw, 100vw",
        "thumb": "(min-width: 40rem) 224px, 100vw"
    },
    "tokens": {
        "base": "#ffffff",
        "contrast": "#1e293b",
        "muted": "#64748b",
        "rule": "#f1f5f9",
        "accent": "#4f46e5",
        "on-accent": "#ffffff",
        "font-body": "Nunito, ui-rounded, system-ui, -apple-system, Segoe UI, sans-serif",
        "font-heading": "Outfit, system-ui, -apple-system, Segoe UI, sans-serif",
        "font-mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "tokens_dark": {
        "base": "#0f172a",
        "contrast": "#e2e8f0",
        "muted": "#94a3b8",
        "rule": "#1e293b",
        "accent": "#818cf8",
        "on-accent": "#0f172a"
    },
    "navigations": {
        "primary": "Header"
    },
    "composers": [],
    "speculation": true
}
